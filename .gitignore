# --- Regenerated by the code, never committed -------------------------------
Dataset/                 # DNS fields; rebuild with: python code/WRSG.py --prepare_data_only
Checkpoints/             # trained weights (~100 GPU-hours); see README "Data and checkpoints"
Results/figures/         # plotting subcommands regenerate these
Results/_queue/          # claim-queue job list, locks and per-GPU logs
Results/_jobs/
Results/_uqens/          # cached UQ ensembles (large); rebuild with uq_gen_ens.py
*.lock

# --- Reviewer correspondence: kept locally, not part of the public release ---
paper/openreview_*.md

# --- LaTeX build artifacts (main.tex, main.bbl and main.pdf are tracked) -----
paper/*.aux
paper/*.log
paper/*.out
paper/*.blg
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/*.spl

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.venv/
myenv/

# --- OS / editor -----------------------------------------------------------
.DS_Store
.vscode/
